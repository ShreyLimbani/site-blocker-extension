{
  "manifest_version": 3,
  "name": "Site Blocker - Focus Helper",
  "version": "1.0.0",
  "description": "Block distracting websites with a timer override option",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Site Blocker"
  }
}
